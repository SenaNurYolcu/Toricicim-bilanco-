+}
+
+export interface GovernanceTimelineEvent {
+  date: string;
+  category: 'auditor_change' | 'cfo_change' | 'board_resignation' | 'spk_penalty' | 'kap_delay' | 'fund_exit' | 'paid_capital_change';
